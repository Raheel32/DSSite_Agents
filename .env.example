# Local quick start uses SQLite. For PostgreSQL use e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/agents_db
DATABASE_URL=sqlite:///./agents.db

# Needed later for the other agents
GOOGLE_API_KEY=your-gemini-key
TAVILY_API_KEY=your-tavily-key

# Protect your endpoints (set long random strings; same values go in Render)
ADMIN_API_KEY=change-me-admin
SITE_API_KEY=change-me-site
